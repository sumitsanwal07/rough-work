# Campus Event Hub — GRAPHITE 26 PS 18 Environment Configuration

# Server Port
PORT=3000

# Persistent SQLite Database Location (defaults to ./campus_hub.db)
DATABASE_PATH=./campus_hub.db

# Optional Supabase Integration
# If deploying to Supabase PostgreSQL, supply project credentials below:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Transactional Email & Push Reminder Service
# Configure your SMTP provider (e.g. Resend, SendGrid, Amazon SES, Brevo, or Gmail SMTP)
# If left blank, the built-in system simulates email delivery, logging each transmission
# and dispatching in-app reminders with full duplicate prevention.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM="Campus Event Hub <events@campus.edu>"

# Security & Session Secrets
SESSION_SECRET=campus_hub_super_secret_session_encryption_key_2026
ADMIN_SETUP_SECRET=graphite26_ps18_admin_setup_passcode
